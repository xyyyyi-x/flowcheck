# 由 python scripts/init_env.py 生成 .env；本文件只登记变量名，不含真实秘密。
# 不要提交 .env 或 .env.e2e。
POSTGRES_DB=arp
POSTGRES_USER=arp
POSTGRES_PASSWORD=
APP_JWT_SECRET=
APP_ENCRYPTION_KEY=
APP_DATABASE_URL=postgresql+asyncpg://arp:CHANGE_ME@db:5432/arp
APP_SYNC_DATABASE_URL=postgresql+psycopg://arp:CHANGE_ME@db:5432/arp
APP_REDIS_BROKER_URL=redis://redis:6379/0
APP_REDIS_CACHE_URL=redis://redis:6379/1
TARGET_ORIGINS=http://demo-api:8001
CORS_ORIGINS=
WEB_PORT=8080
API_PORT=8000
DEMO_PORT=8001
DEMO_USERNAME=demo
DEMO_PASSWORD=
